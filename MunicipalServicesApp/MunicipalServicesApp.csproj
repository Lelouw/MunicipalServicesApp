<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MunicipalServicesApp</RootNamespace>
    <AssemblyName>MunicipalServicesApp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon />
    <StartupObject>MunicipalServicesApp.Program</StartupObject>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>City of Jozi Municipal Services</Product>
    <Company>City of Jozi</Company>
    <Description>Part 2 municipal services desktop application for City of Jozi. Report issues, and browse local events and announcements.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Forms\EventDetailsForm.Designer.cs">
      <DependentUpon>EventDetailsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\IssueDetailsForm.Designer.cs">
      <DependentUpon>IssueDetailsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\LocalEventsForm.Designer.cs">
      <DependentUpon>LocalEventsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\MainMenuForm.Designer.cs">
      <DependentUpon>MainMenuForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\ReportIssuesForm.Designer.cs">
      <DependentUpon>ReportIssuesForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
