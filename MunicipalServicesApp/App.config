<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="LocationSearchUrl" value="https://nominatim.openstreetmap.org/search" />
    <add key="LocationSearchCountryCodes" value="za" />
    <add key="LocationSearchUserAgent" value="MunicipalServicesApp/1.0 (AAPD7112W POE; municipal issue reporting)" />
    <add key="LocationSearchLimit" value="8" />
    <add key="LocationSearchDebounceMs" value="450" />
    <add key="LocationSearchMinQueryLength" value="3" />
    <add key="LocationSearchTimeoutSeconds" value="8" />
  </appSettings>
</configuration>
